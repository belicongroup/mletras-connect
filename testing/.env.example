# API base URL (local worker with test routes enabled)
SIM_API_URL=http://127.0.0.1:8787

# Number of concurrent simulated users (default: 5)
SIM_CONCURRENT_USERS=5

# Simulation duration in seconds (default: 60)
SIM_DURATION_SECONDS=60

# Comma-separated scenario groups to run (default: all)
# Options: auth, profile, feed, posts, comments, notifications, security, stress, edge-cases
SIM_SCENARIOS=

# Require test routes (/__test__/*) — abort if unavailable
SIM_REQUIRE_TEST_ROUTES=true
